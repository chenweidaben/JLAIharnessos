/**
 * 健澜科技 jlmedaios - 小程序全局样式（M3-J）
 * 健澜深海蓝主色 #0B3D91
 */
page {
  background-color: #f5f7fa;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  color: #1f2937;
  font-size: 28rpx;
}

.container {
  padding: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(11, 61, 145, 0.06);
}

.btn-primary {
  background-color: #0b3d91;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.btn-primary[disabled] {
  background-color: #9db4d8;
  color: #f0f4fa;
}

.btn-ghost {
  background-color: #ffffff;
  color: #0b3d91;
  border: 1rpx solid #0b3d91;
  border-radius: 12rpx;
}

.text-muted {
  color: #7a869a;
}

.text-primary {
  color: #0b3d91;
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
}

.tag-green {
  background-color: #e6f7ec;
  color: #16a34a;
}

.tag-gold {
  background-color: #fdf6e3;
  color: #d97706;
}

.tag-blue {
  background-color: #e8f0fb;
  color: #0b3d91;
}

.form-label {
  font-size: 28rpx;
  color: #4b5563;
  margin-bottom: 12rpx;
}

.form-input {
  background-color: #f5f7fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
