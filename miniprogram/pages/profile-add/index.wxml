<!-- 健澜科技 jlmedaios - 小程序添加就诊人页（M3-J） -->
<view class="container">

  <view wx:if="{{!loggedIn}}" class="card empty-card">
    <view class="empty-title">请先登录</view>
    <button class="btn-primary empty-btn" bindtap="goLogin">去登录</button>
  </view>

  <view wx:if="{{loggedIn}}" class="card form-card">
    <view class="form-row">
      <view class="form-label">与本人关系</view>
      <picker
        mode="selector"
        range="{{relations}}"
        range-key="label"
        value="{{relationIndex}}"
        bindchange="onRelationChange"
      >
        <view class="form-input picker-value">
          {{relations[relationIndex].label}}
        </view>
      </picker>
    </view>

    <view class="form-row">
      <view class="form-label">姓名</view>
      <input
        class="form-input"
        placeholder="请输入真实姓名"
        value="{{name}}"
        bindinput="onNameInput"
      />
    </view>

    <view class="form-row">
      <view class="form-label">性别</view>
      <picker
        mode="selector"
        range="{{genderOptions}}"
        value="{{genderIndex}}"
        bindchange="onGenderChange"
      >
        <view class="form-input picker-value">{{gender}}</view>
      </picker>
    </view>

    <view class="form-row">
      <view class="form-label">出生日期</view>
      <picker mode="date" value="{{birthDate}}" bindchange="onBirthChange">
        <view class="form-input picker-value">
          {{birthDate || '请选择出生日期'}}
        </view>
      </picker>
    </view>

    <view class="form-row row-between switch-row">
      <view class="form-label !mb-0">设为默认就诊人</view>
      <switch checked="{{isDefault}}" color="#0B3D91" bindchange="onDefaultChange" />
    </view>

    <button
      class="btn-primary submit-btn"
      loading="{{submitting}}"
      disabled="{{submitting}}"
      bindtap="handleSubmit"
    >
      保存就诊人
    </button>
    <view class="text-muted form-tip">保存后建议立即完成实名认证，以开通在线复诊、电子处方等服务。</view>
  </view>
</view>
