# 健澜科技数智医院智能体（jlmedaios）前端环境变量示例
# 用法：复制为 .env.development（本地开发）或 .env.production（生产构建）后按需修改。
# Vite 仅向客户端暴露以 VITE_ 开头的变量，请勿在此放置任何密钥。

# 应用标题（显示在浏览器标签与关于页）
VITE_APP_TITLE=健澜科技数智医院智能体

# 后端 BFF API 基础地址。
# 开发态建议保留 /api/v1，由 Vite 代理转发到 VITE_PROXY_TARGET（默认 8080）。
VITE_API_BASE_URL=/api/v1

# WebSocket 实时通道（AI 对话流式输出 + 危急值/告警实时推送）。
# 端点固定为 /ws/chat（连接时自动附加 ?token=<accessToken> 做鉴权）。
# 开发态经 Vite 代理 /ws → ws://127.0.0.1:8080；生产为 wss://<ws-host>/ws/chat。
VITE_WS_URL=ws://127.0.0.1:5173/ws/chat

# 是否启用本地内置 Mock 数据与离线确定性医疗回复引擎。
# 开发/演示可设 true；生产必须设 false，所有请求走真实 BFF 与医疗 Agent。
VITE_MOCK_ENABLED=true

# 演示模式开关（优先于 VITE_MOCK_ENABLED）：
#   0 = 真实模式（默认）：直连 BFF，API 失败显式报错，绝不静默返回假数据。
#   1 = 演示模式：顶部显示“演示模式 - 数据不持久化”水印，API fallback 到 web/src/mock。
VITE_DEMO_MODE=0

# 运行环境：development / test / production
VITE_APP_ENV=development

# —— 以下为可选的 Vite 开发代理目标（默认指向本机 BFF 8080）——
# VITE_PROXY_TARGET=http://127.0.0.1:8080
# VITE_WS_PROXY_TARGET=ws://127.0.0.1:8080
