# ============================================================================
# 健澜科技杠OS — Docker Compose 环境变量样例
# ----------------------------------------------------------------------------
# 使用方法：
#   1) 复制本文件为 .env：cp .env.compose.example .env
#   2) 将所有标注「必填密钥」的占位符替换为高强度随机值（切勿提交真实值到仓库）；
#   3) docker compose 会自动读取同目录 .env 完成变量插值。
#
# 生成随机密钥的推荐命令（任选其一，长度 ≥32 字节）：
#   openssl rand -base64 48     # 推荐
#   docker run --rm registry.jianlan.tech/jianlan/backend:0.1.0 \
#     bun -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
#
# 红线：
#   - .env 已在 .gitignore/.dockerignore 中，严禁入库；
#   - 生产环境所有密码/密钥必须通过密钥管理系统或 CI Secret 注入；
#   - ENCRYPTION_MASTER_KEY 一旦用于加密患者敏感字段，轮换需走数据重加密流程，
#     请在上线前生成并离线备份（分人保管、密封留存）。
# ============================================================================

# ----------------------------------------------------------------------------
# 一、通用参数
# ----------------------------------------------------------------------------
# 镜像版本号（与所有 registry.jianlan.tech/jianlan/* 镜像 tag 对齐）。
APP_VERSION=0.1.0
# 应用环境标识：dev=开发联调，staging=预发布，prod=生产。
APP_ENV=prod
# 日志级别：debug / info / warn / error；生产用 info，排障时临时调 debug。
LOG_LEVEL=info
# 时区（容器内系统时区）。
TZ=Asia/Shanghai

# ----------------------------------------------------------------------------
# 二、对外端口（边缘网关）
# 生产机若前面还有 SLB，可保持 80/443；本机联调被占用时可改为 8080/8443。
# ----------------------------------------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443
# 后端 BFF 直连调试端口（仅绑定 127.0.0.1，生产扩容多副本时应在 compose 中移除）。
APP_PORT=8080

# ----------------------------------------------------------------------------
# 三、PostgreSQL（业务主库）
# ----------------------------------------------------------------------------
# 数据库业务账号（非超级用户语义由初始化脚本保证；首次初始化后修改密码不会自动生效）。
POSTGRES_USER=jianlan
# 必填密钥：数据库口令，建议 24 位以上随机字符串（大小写+数字+符号）。
POSTGRES_PASSWORD=CHANGE_ME_postgres_strong_password
# 业务数据库名。
POSTGRES_DB=gangos
# 宿主机回环调试端口（仅 127.0.0.1 监听）。
POSTGRES_PORT=5432

# ----------------------------------------------------------------------------
# 四、Redis（缓存/分布式锁/限流/会话）
# ----------------------------------------------------------------------------
# 必填密钥：Redis 访问口令（启动时以 --requirepass 注入，不写入镜像）。
REDIS_PASSWORD=CHANGE_ME_redis_strong_password
# 宿主机回环调试端口。
REDIS_PORT=6379

# ----------------------------------------------------------------------------
# 五、Kafka（KRaft 消息总线）
# ----------------------------------------------------------------------------
# 宿主机回环调试端口（controller 9093 不发布）。
KAFKA_PORT=9092

# ----------------------------------------------------------------------------
# 六、应用安全密钥
# ----------------------------------------------------------------------------
# 必填密钥：JWT 签名密钥（HS256，≥32 字节随机值）；泄露后所有已签发令牌可被伪造。
JWT_SECRET=CHANGE_ME_jwt_secret_openssl_rand_base64_48
# 必填密钥：患者敏感字段（姓名/身份证号/电话）加密主密钥（≥32 字节，妥善离线备份）。
ENCRYPTION_MASTER_KEY=CHANGE_ME_encryption_master_key_openssl_rand_base64_48

# ----------------------------------------------------------------------------
# 六之二、AI 影像辅诊（DAMO-RADAR 推理服务，docker-compose.yml radar-inference）
# ----------------------------------------------------------------------------
# 推理服务内网地址（compose 服务名；本机直连调试可改为 http://localhost:8090）。
RADAR_INFERENCE_URL=http://radar-inference:8090
# 必填密钥：BFF 与推理服务共享的内部鉴权 token（X-Internal-Token），≥32 字节随机值。
RADAR_INTERNAL_TOKEN=CHANGE_ME_radar_internal_token_openssl_rand_base64_48
# 阳性概率阈值（默认 0.5，可按院内调参）。
RADAR_POSITIVE_THRESHOLD=0.5

# ----------------------------------------------------------------------------
# 七、可观测性组件
# ----------------------------------------------------------------------------
# Prometheus 宿主机回环端口。
PROMETHEUS_PORT=9090
# Grafana 管理员账号与初始口令（首次启动后请在界面修改）。
GRAFANA_ADMIN_USER=admin
# 必填密钥：Grafana 管理员口令。
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_admin_password
GRAFANA_PORT=3000
# Jaeger 查询 UI 宿主机回环端口。
JAEGER_PORT=16686

# ----------------------------------------------------------------------------
# 八、日志平台（Elasticsearch / Kibana）
# ----------------------------------------------------------------------------
# 必填密钥：Elasticsearch 内置 elastic 账号口令（Kibana 复用同一凭据）。
ES_PASSWORD=CHANGE_ME_elastic_strong_password
ES_PORT=9200
KIBANA_PORT=5601

# ----------------------------------------------------------------------------
# 九、TLS 证书（仅生产覆盖文件 docker-compose.prod.yml 使用）
# ----------------------------------------------------------------------------
# 正式证书目录，目录内须含 tls.crt（服务器证书+中间链）与 tls.key（私钥）。
# 开发联调留空即可：边缘网关会自动生成临时自签证书（浏览器告警，禁止用于生产）。
# 生产示例（Linux）：TLS_CERT_DIR=/etc/jianlan/certs
#TLS_CERT_DIR=/etc/jianlan/certs
