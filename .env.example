# 健澜科技数智医院智能体 - 环境变量示例
# Copyright (c) 2026 健澜科技. All rights reserved.
#
# 用法：cp .env.example .env.development，再按实际环境填写。
# 严禁把包含真实密钥的 .env* 文件提交到 Git（.gitignore 已忽略）。

# ---------- 运行环境 ----------
NODE_ENV=development          # development | test | production
APP_ENV=development           # dev | staging | prod
LOG_LEVEL=debug               # debug | info | warn | error | critical

# ---------- 应用 ----------
APP_NAME=jianlan-medical-agent
APP_VERSION=0.2.0
HTTP_PORT=8080
# 接口超时（毫秒）
HTTP_TIMEOUT_MS=30000

# ---------- 数据库（PostgreSQL 16，真实模式必填） ----------
# 本地 Docker 启动：docker compose up -d postgres
# 连接串格式：postgres://user:password@host:port/dbname
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jlmedaios
# 本地开发关闭 SSL（Docker 内网）；生产环境启用
PGSSLMODE=disable
# 连接池上限
PG_POOL_MAX=20
# 演示模式：=1 时跳过 DB 连接，使用内存演示数据（不持久化，仅限演示）
DEMO_MODE=0

# ---------- 大模型（LLM） ----------
# 生产环境务必使用密钥管理服务，不要写死在文件里
LLM_PROVIDER=anthropic
LLM_API_KEY=sk-placeholder-replace-me
LLM_MODEL=claude-sonnet-4-5
LLM_BASE_URL=https://api.anthropic.com
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=60000

# ---------- 医院信息系统对接 ----------
HIS_BASE_URL=http://his.hospital.internal:8080
HIS_API_KEY=his-placeholder-replace-me
HIS_TIMEOUT_MS=5000

EMR_BASE_URL=http://emr.hospital.internal:8081
EMR_API_KEY=emr-placeholder-replace-me

LIS_BASE_URL=http://lis.hospital.internal:8082
PACS_BASE_URL=http://pacs.hospital.internal:8083

# ---------- AI 影像辅诊（DAMO-RADAR 推理服务） ----------
# BFF 访问推理服务的地址；本机直连用 http://localhost:8090，容器编排用 http://radar-inference:8090
RADAR_INFERENCE_URL=http://localhost:8090
# 必填密钥：BFF 与推理服务共享的内部鉴权 token（X-Internal-Token）；未配置时服务仅允许回环调用
RADAR_INTERNAL_TOKEN=CHANGE_ME_radar_internal_token
# 阳性概率阈值（默认 0.5，可按院内调参）
RADAR_POSITIVE_THRESHOLD=0.5

# ---------- 知识库 / 向量库 ----------
VECTOR_STORE_DIR=./data/vectors
EMBEDDING_MODEL=bge-large-zh
EMBEDDING_DIM=1024

# ---------- 日志与审计 ----------
LOG_DIR=./logs
# 单文件大小（字节），默认 10MB
LOG_MAX_SIZE=10485760
# 保留历史文件数
LOG_MAX_FILES=14
# 审计日志保留天数（等保三级要求 >= 180 天）
AUDIT_RETENTION_DAYS=180

# ---------- 安全 ----------
# 数据加密主密钥（生产环境必须由 KMS 下发）
ENCRYPTION_MASTER_KEY=placeholder-32-byte-master-key-replace-me
JWT_SECRET=jwt-placeholder-replace-me
# 是否启用数据脱敏（生产必须 true）
ENABLE_DESENSITIZATION=true
# 是否开启 Prompt Injection 防护
ENABLE_PROMPT_GUARD=true

# ---------- 监控 ----------
# Sentry / 自建错误上报 DSN，留空则不上报
SENTRY_DSN=
# 性能告警阈值（毫秒）
PERF_API_TIMEOUT_MS=2000
PERF_TOOL_TIMEOUT_MS=5000
# 健康检查端点
HEALTH_CHECK_PATH=/health
