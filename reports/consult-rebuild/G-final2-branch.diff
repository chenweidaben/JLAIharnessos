+/**
+ * Pharmacist 药师角色（契约 §5 pharmacistRole）
+ *
+ * Copyright (c) 2026 杭州健澜科技有限公司
+ *
+ * 生成用药审方 / 处方草稿（kind=prescription）：核对过敏史与相互作用；
+ * isOutOfHospitalPrescription=false；needsPhysicianReview=true；禁止直接开具
+ * 在院医嘱；附风险提示与免责声明。
+ */
+
+import { createAuditEntry } from '../audit';
+import { SAMPLE_DRUG_FACTS } from '../demo/demoSeed';
+import { computeDraftHash } from '../draftHash';
+import type { SafeLlmPort } from '../llm/safeLlm';
+import { extractFactsFromText } from '../memory/profileMemory';
+import type { RoleInput, RoleOutput, RolePort } from '../ports';
+import { appendDisclaimer, newId, nowIso } from '../roleSupport';
+import type { ConsultDraft, EvidenceItem, RoleKind } from '../types';
+import { DISCLAIMER } from '../types';
+import { dedupeEvidence, invokeToolWithAudit } from './internal';
+
+/** 从文本确定性识别药品通用名（先匹配 DEMO 药表，再按剂型后缀兜底；未命中返回空串） */
+function extractDrugName(text: string): string {
+  for (const sample of SAMPLE_DRUG_FACTS) {
+    const hit = sample.keywords.find((keyword) => text.includes(keyword));
+    if (hit) {
+      return hit;
+    }
+  }
+  const match = /([一-龥A-Za-z]{2,12}(?:片|胶囊|颗粒|注射液|口服液|软膏))/.exec(text);
+  return match?.[1] ?? '';
+}
+
+/** 组装用药建议草稿正文（含风险提示、红线声明与常驻免责声明） */
+function buildPrescriptionContent(
+  userText: string,
+  drugName: string,
+  evidence: EvidenceItem[],
+  llmText: string,
+): string {
+  const evidenceLines = evidence.length
+    ? evidence
+        .map((item, index) => `${index + 1}. [${item.kind}] ${item.label}：${item.snippet}`)
+        .join('\n')
+    : '（本轮未检索到药品说明书或相互作用证据，须线下由药师当面核对。）';
+  const drugLine = drugName
+    ? `【咨询药品】${drugName}`
+    : '【咨询药品】未识别到具体药品通用名，请补充药品名称。';
+  return [
+    drugLine,
+    '',
+    `【咨询摘要】${userText.trim()}`,
+    '',
+    `【AI 用药整理】${llmText}`,
+    '',
+    '风险提示：用药前须核对过敏史、肝肾功能、孕哺状态与联用药物；存在过敏史、相互作用或基础疾病时，应暂缓用药并线下咨询执业医师 / 药师。',
+    '',
+    '红线声明：本草稿不构成在院医嘱，不直接开具处方，不属于院外处方；最终用药方案须由执业医师 / 药师复核后确定。',
+    '',
+    '【证据清单】',
+    evidenceLines,
+    '',
+    DISCLAIMER,
+  ].join('\n');
+}
+
+/** Pharmacist 角色实现 */
+export class PharmacistRole implements RolePort {
+  readonly kind: RoleKind = 'pharmacist';
+
+  constructor(private readonly llm: SafeLlmPort) {}
+
+  async handle(input: RoleInput): Promise<RoleOutput> {
+    const drugName = extractDrugName(input.userText);
+    const drugNames = drugName ? [drugName] : [];
+
+    const drugOutcome = await invokeToolWithAudit({
+      actorRole: 'pharmacist',
+      threadId: input.thread.id,
+      traceId: input.traceId,
+      tools: input.tools,
+      memory: input.profile,
+      toolName: 'lookupDrug',
+      args: { drugName },
+    });
+    const allergyOutcome = await invokeToolWithAudit({
+      actorRole: 'pharmacist',
+      threadId: input.thread.id,
+      traceId: input.traceId,
+      tools: input.tools,
+      memory: input.profile,
+      toolName: 'checkAllergy',
+      args: {},
+    });
+    const interactionOutcome = await invokeToolWithAudit({
+      actorRole: 'pharmacist',
+      threadId: input.thread.id,
+      traceId: input.traceId,
+      tools: input.tools,
+      memory: input.profile,
+      toolName: 'checkInteraction',
+      args: { drugNames },
+    });
+
+    const evidence = dedupeEvidence([
+      ...drugOutcome.evidence,
+      ...allergyOutcome.evidence,
+      ...interactionOutcome.evidence,
+    ]);
+
+    const llmResult = await this.llm.complete(input.userText, 'pharmacist');
+    const summary = drugName
+      ? `围绕“${drugName}”整理的用药建议草稿，待执业医师 / 药师复核。`
+      : '未识别到具体药品的用药建议草稿，待补充药品名称后复核。';
+    const content = buildPrescriptionContent(input.userText, drugName, evidence, llmResult.text);
+
+    const draft: ConsultDraft = {
+      id: newId('draft'),
+      threadId: input.thread.id,
+      kind: 'prescription',
+      title: drugName ? `用药建议草稿：${drugName}（待复核）` : '用药建议草稿（待复核）',
+      summary,
+      content,
+      evidence,
+      needsPhysicianReview: true,
+      isOutOfHospitalPrescription: false,
+      status: 'pending_review',
+      draftHash: '',
+      reviewerId: null,
+      reviewedAt: null,
+      reviewNote: null,
+      createdAt: nowIso(),
+      updatedAt: nowIso(),
+    };
+    draft.draftHash = computeDraftHash(draft);
+
+    const memoryUpdates = extractFactsFromText(input.userText, input.thread.id);
+
+    const roleAudit = createAuditEntry({
+      threadId: input.thread.id,
+      actorRole: 'pharmacist',
+      action: 'pharmacist_draft',
+      traceId: input.traceId,
+      detail: {
+        draftKind: 'prescription',
+        drugName,
+        evidenceCount: evidence.length,
+        degradedLlm: llmResult.degraded,
+      },
+    });
+
+    const reply = appendDisclaimer(
+      `${llmResult.text}\n已生成用药建议草稿，待执业医师 / 药师复核；AI 不直接开具处方或在院医嘱。`,
+    );
+
+    return {
+      reply,
+      nextRole: null,
+      draft,
+      evidence,
+      followUpQuestions: [],
+      memoryUpdates,
+      audit: [roleAudit, drugOutcome.audit, allergyOutcome.audit, interactionOutcome.audit],
+      degradedLlm: llmResult.degraded,
+    };
+  }
+}
diff --git a/src/core/agent/consult/roles/supervisorRole.ts b/src/core/agent/consult/roles/supervisorRole.ts
new file mode 100644
index 00000000..8f4158a8
--- /dev/null
+++ b/src/core/agent/consult/roles/supervisorRole.ts
@@ -0,0 +1,74 @@
+/**
+ * Supervisor 分诊角色（契约 §5 supervisorRole）
+ *
+ * Copyright (c) 2026 杭州健澜科技有限公司
+ *
+ * 先由编排层完成安全旁路（acute 不进入角色）；本角色按意图选择下一角色，
+ * 产出编排级回复与 nextRole，不生成草稿、不直接给临床结论。
+ */
+
+import { createAuditEntry } from '../audit';
+import type { SafeLlmPort } from '../llm/safeLlm';
+import type { RoleInput, RoleOutput, RolePort } from '../ports';
+import { appendDisclaimer } from '../roleSupport';
+import { routeNextRole } from '../supervisor';
+import type { RoleKind } from '../types';
+
+/** 按意图与路由结果生成分诊引导文案 */
+function routingGuidance(intent: RoleInput['intent'], nextRole: RoleKind | null): string {
+  if (nextRole === 'pharmacist') {
+    return '您咨询的是用药相关问题，已为您转接药师角色协助核对。';
+  }
+  if (nextRole === 'doctor') {
+    return '您描述的情况已转交医师角色整理诊断建议草稿，供执业医师复核参考。';
+  }
+  if (nextRole === 'examiner') {
+    return '目前信息尚不足以进入专业角色，先由问诊角色向您补充确认关键信息。';
+  }
+  if (intent === 'greeting') {
+    return '若您有症状、用药或慢病管理相关问题，可以直接描述；如出现急症信号请立即拨打 120 或前往急诊。';
+  }
+  return '已接收您的咨询，将按问题类型安排相应角色协助处理。';
+}
+
+/** Supervisor 角色实现 */
+export class SupervisorRole implements RolePort {
+  readonly kind: RoleKind = 'supervisor';
+
+  constructor(private readonly llm: SafeLlmPort) {}
+
+  async handle(input: RoleInput): Promise<RoleOutput> {
+    const nextRole = routeNextRole({
+      intent: input.intent,
+      text: input.userText,
+      history: input.history,
+    });
+    const llmResult = await this.llm.complete(input.userText, 'supervisor');
+    const reply = appendDisclaimer(
+      [llmResult.text, routingGuidance(input.intent, nextRole)].join('\n'),
+    );
+
+    const audit = createAuditEntry({
+      threadId: input.thread.id,
+      actorRole: 'supervisor',
+      action: 'supervisor_triage',
+      traceId: input.traceId,
+      detail: {
+        intent: input.intent,
+        nextRole,
+        degradedLlm: llmResult.degraded,
+      },
+    });
+
+    return {
+      reply,
+      nextRole,
+      draft: null,
+      evidence: [],
+      followUpQuestions: [],
+      memoryUpdates: [],
+      audit: [audit],
+      degradedLlm: llmResult.degraded,
+    };
+  }
+}
diff --git a/src/core/agent/consult/runtime/sessionRuntime.ts b/src/core/agent/consult/runtime/sessionRuntime.ts
new file mode 100644
index 00000000..c5167a2d
--- /dev/null
+++ b/src/core/agent/consult/runtime/sessionRuntime.ts
@@ -0,0 +1,184 @@
+/**
+ * DEMO 进程内会话运行时（契约 §0 runtime/sessionRuntime.ts，§10 落库短路）
+ *
+ * Copyright (c) 2026 杭州健澜科技有限公司
+ *
+ * DEMO_MODE=1 时线程 / 消息 / 草稿 / 审计 / 画像 / 文档全部存储于进程内 Map，
+ * 不连接数据库；后续非 DEMO 模式由 consultAgentRepo 实现同一 ConsultAgentPort。
+ * 本类仅供核心包 DEMO 短路与本分片单元测试使用，不被 BFF 路由直接引用。
+ */
+
+import { createProfileMemory } from '../memory/profileMemory';
+import type { MemoryCheckpoint } from '../memory/shortTermMemory';
+import type { ConsultAgentPort } from '../ports';
+import { newId, nowIso } from '../roleSupport';
+import type {
+  ConsultAuditEntry,
+  ConsultDocument,
+  ConsultDraft,
+  ConsultMessage,
+  ConsultProfileMemory,
+  ConsultThread,
+  IntentKind,
+  SafetyLevel,
+} from '../types';
+
+/** 是否处于 DEMO_MODE（1 开启）；非 DEMO 模式由 BFF 仓储分片落库 */
+export function isDemoMode(): boolean {
+  return process.env.DEMO_MODE === '1';
+}
+
+/** 新建线程入参 */
+export interface CreateThreadParams {
+  userId: string;
+  title?: string;
+  patientId?: string | null;
+  intent?: IntentKind;
+  safetyLevel?: SafetyLevel;
+}
+
+/** 进程内咨询会话存储：实现 ConsultAgentPort 全部读写方法 */
+export class SessionRuntime implements ConsultAgentPort {
+  private readonly threads = new Map<string, ConsultThread>();
+  private readonly messages = new Map<string, ConsultMessage[]>();
+  private readonly drafts = new Map<string, ConsultDraft[]>();
+  private readonly audits = new Map<string, ConsultAuditEntry[]>();
+  private readonly profiles = new Map<string, ConsultProfileMemory>();
+  private readonly documents = new Map<string, ConsultDocument[]>();
+  private readonly checkpoints = new Map<string, MemoryCheckpoint>();
+
+  // ---- 线程 ----
+
+  async findThread(threadId: string, userId: string): Promise<ConsultThread | null> {
+    const thread = this.threads.get(threadId);
+    return thread?.userId === userId ? thread : null;
+  }
+
+  async listThreads(userId: string): Promise<ConsultThread[]> {
+    return [...this.threads.values()]
+      .filter((thread) => thread.userId === userId)
+      .sort((a, b) => b.updatedAt.localeCompare(a.updatedAt));
+  }
+
+  async saveThread(thread: ConsultThread): Promise<ConsultThread> {
+    this.threads.set(thread.id, thread);
+    return thread;
+  }
+
+  /** 在内存中新建线程并落表，返回初始线程实体 */
+  createThread(params: CreateThreadParams): ConsultThread {
+    const now = nowIso();
+    const titleText = params.title?.trim();
+    const thread: ConsultThread = {
+      id: newId('thread'),
+      userId: params.userId,
+      patientId: params.patientId ?? null,
+      title: titleText && titleText.length > 0 ? titleText : '在线咨询会话',
+      status: 'idle',
+      intent: params.intent ?? 'unknown',
+      safetyLevel: params.safetyLevel ?? 'normal',
+      currentRole: null,
+      meta: {},
+      closedAt: null,
+      createdAt: now,
+      updatedAt: now,
+    };
+    this.threads.set(thread.id, thread);
+    return thread;
+  }
+
+  // ---- 消息 ----
+
+  async listMessages(threadId: string): Promise<ConsultMessage[]> {
+    return [...(this.messages.get(threadId) ?? [])];
+  }
+
+  async saveMessage(message: ConsultMessage): Promise<ConsultMessage> {
+    const list = this.messages.get(message.threadId) ?? [];
+    list.push(message);
+    this.messages.set(message.threadId, list);
+    return message;
+  }
+
+  // ---- 草稿 ----
+
+  async listDrafts(threadId: string, kind: ConsultDraft['kind']): Promise<ConsultDraft[]> {
+    return (this.drafts.get(threadId) ?? [])
+      .filter((draft) => draft.kind === kind)
+      .sort((a, b) => b.createdAt.localeCompare(a.createdAt));
+  }
+
+  async saveDraft(draft: ConsultDraft): Promise<ConsultDraft> {
+    const list = this.drafts.get(draft.threadId) ?? [];
+    list.push(draft);
+    this.drafts.set(draft.threadId, list);
+    return draft;
+  }
+
+  // ---- 审计 ----
+
+  async listAudit(threadId: string): Promise<ConsultAuditEntry[]> {
+    return [...(this.audits.get(threadId) ?? [])].sort((a, b) =>
+      a.createdAt.localeCompare(b.createdAt),
+    );
+  }
+
+  async saveAudit(entry: ConsultAuditEntry): Promise<void> {
+    const list = this.audits.get(entry.threadId) ?? [];
+    list.push(entry);
+    this.audits.set(entry.threadId, list);
+  }
+
+  // ---- 画像 ----
+
+  async getProfile(userId: string): Promise<ConsultProfileMemory> {
+    const existing = this.profiles.get(userId);
+    return existing ?? createProfileMemory(userId);
+  }
+
+  async saveProfile(profile: ConsultProfileMemory): Promise<ConsultProfileMemory> {
+    this.profiles.set(profile.userId, profile);
+    return profile;
+  }
+
+  // ---- 文档 ----
+
+  async listDocuments(threadId: string): Promise<ConsultDocument[]> {
+    return [...(this.documents.get(threadId) ?? [])];
+  }
+
+  async saveDocument(document: ConsultDocument): Promise<ConsultDocument> {
+    const list = this.documents.get(document.threadId) ?? [];
+    list.push(document);
+    this.documents.set(document.threadId, list);
+    return document;
+  }
+
+  // ---- 短期记忆 checkpoint ----
+
+  /** 保存线程消息 checkpoint（短期记忆 DEMO 存储） */
+  saveCheckpoint(checkpointEntry: MemoryCheckpoint): void {
+    this.checkpoints.set(checkpointEntry.threadId, checkpointEntry);
+  }
+
+  /** 读取线程最近 checkpoint；不存在返回 null */
+  getCheckpoint(threadId: string): MemoryCheckpoint | null {
+    return this.checkpoints.get(threadId) ?? null;
+  }
+
+  /** 清空全部内存数据（测试隔离使用） */
+  clear(): void {
+    this.threads.clear();
+    this.messages.clear();
+    this.drafts.clear();
+    this.audits.clear();
+    this.profiles.clear();
+    this.documents.clear();
+    this.checkpoints.clear();
+  }
+}
+
+/** 创建 DEMO 进程内运行时实例 */
+export function createDemoRuntime(): SessionRuntime {
+  return new SessionRuntime();
+}
