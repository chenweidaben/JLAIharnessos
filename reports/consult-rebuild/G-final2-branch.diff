+                            animation: 'consult-blink 1s step-end infinite',
+                          }}
+                        >
+                          ▍
+                        </span>
+                      )}
+                    </div>
+                    {message.role === 'assistant' && (
+                      <div style={{ marginTop: 6, fontSize: 10, color: '#999' }}>
+                        {message.disclaimer || DISCLAIMER}
+                      </div>
