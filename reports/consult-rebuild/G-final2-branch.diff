+            background: '#fff',
+            border: '1px solid #d9e3ef',
+            borderRadius: 8,
+            display: 'flex',
+            flexDirection: 'column',
+            overflow: 'hidden',
+          }}
+        >
+          <div style={{ flex: 1, overflowY: 'auto', padding: 16, background: '#fafbfd' }}>
+            {/* 急症旁路 Alert：会话处于 acute 状态或收到 safety:acute 帧时常驻展示 */}
+            {(acute || threadAcute) && (
