+/** 按草稿类型替换既有草稿（同类型仅保留最新一份） */
+function upsertDraft(prev: ConsultDraft[], draft: ConsultDraft): ConsultDraft[] {
+  return [...prev.filter((d) => d.kind !== draft.kind), draft];
