+/**
+ * 单元测试 - 工具注册表（契约 §6）
+ *
+ * Copyright (c) 2026 杭州健澜科技有限公司
+ */
+
+import { describe, expect, it } from 'bun:test';
+
+import { createProfileMemory } from '../../../src/core/agent/consult/memory/profileMemory';
+import {
+  createDefaultToolRegistry,
+  type ToolContext,
+  ToolRegistry,
+} from '../../../src/core/agent/consult/tools/toolRegistry';
+
+function makeToolContext(profile = createProfileMemory('u-test-001')): ToolContext {
+  return { traceId: 'trace-test-m86', memory: profile };
+}
+
+describe('toolRegistry 工具注册表', () => {
+  it('规范驼峰名与下划线别名均可解析', () => {
+    const registry = createDefaultToolRegistry();
+    expect(registry.resolve('lookupDrug')?.name).toBe('lookupDrug');
+    expect(registry.resolve('lookup_drug')?.name).toBe('lookupDrug');
+    expect(registry.resolve('search_knowledge_base')?.aliases).toContain('search_knowledge_base');
+    expect(registry.resolve('nonexistent_tool')).toBeNull();
+  });
+
+  it('参数归一化：下划线键转驼峰', () => {
+    const registry = new ToolRegistry();
+    const normalized = registry.normalizeArgs({ drug_name: '布洛芬', query_keyword: '咳嗽' });
+    expect(normalized.drugName).toBe('布洛芬');
+    expect(normalized.queryKeyword).toBe('咳嗽');
+  });
+
+  it('invoke 阶段按 knownArgs 白名单剔除未知键', async () => {
+    const registry = createDefaultToolRegistry();
+    const result = await registry.invoke(
+      'lookupDrug',
+      { drug_name: '布洛芬', should_not_exist: 'secret' },
+      makeToolContext(),
+    );
+    expect(result.success).toBe(true);
+    expect(result.evidence.length).toBeGreaterThan(0);
+    expect(result.summary).toContain('布洛芬');
+  });
+
+  it('内置知识库工具返回确定性科普证据', async () => {
+    const registry = createDefaultToolRegistry();
+    const result = await registry.invoke(
+      'searchKnowledgeBase',
+      { query: '咳嗽 感冒' },
+      makeToolContext(),
+    );
+    expect(result.success).toBe(true);
+    expect(result.evidence.length).toBeGreaterThan(0);
+    expect(result.evidence[0].kind).toBe('knowledge');
+    expect(result.errorClass).toBeNull();
+  });
+
+  it('内置药品工具命中布洛芬说明书摘要', async () => {
+    const registry = createDefaultToolRegistry();
+    const result = await registry.invoke('lookup_drug', { drugName: '布洛芬' }, makeToolContext());
+    expect(result.success).toBe(true);
+    expect(result.evidence.some((item) => item.kind === 'drug')).toBe(true);
+  });
+
+  it('checkAllergy 读取画像过敏事实并归入 allergy 证据', async () => {
+    const profile = createProfileMemory('u-test-001');
+    profile.facts = [
+      {
+        key: 'allergy',
+        value: '对青霉素过敏（待医师核实）',
+        source: 'thread-1',
+        updatedAt: new Date().toISOString(),
+      },
+    ];
+    const registry = createDefaultToolRegistry();
+    const result = await registry.invoke('checkAllergy', {}, makeToolContext(profile));
+    expect(result.success).toBe(true);
+    expect(result.evidence.some((item) => item.kind === 'allergy')).toBe(true);
+  });
+
+  it('checkInteraction 对多药联用给出相互作用风险提示', async () => {
+    const registry = createDefaultToolRegistry();
+    const result = await registry.invoke(
+      'checkInteraction',
+      { drugNames: ['布洛芬', '阿司匹林'] },
+      makeToolContext(),
+    );
+    expect(result.success).toBe(true);
+    expect(result.evidence.some((item) => item.kind === 'interaction')).toBe(true);
+  });
+
+  it('retrievePatientHistory 读取画像慢性病事实', async () => {
+    const profile = createProfileMemory('u-test-001');
+    profile.facts = [
+      {
+        key: 'chronic_condition',
+        value: '高血压',
+        source: 'thread-1',
+        updatedAt: new Date().toISOString(),
+      },
+    ];
+    const registry = createDefaultToolRegistry();
+    const result = await registry.invoke('retrievePatientHistory', {}, makeToolContext(profile));
+    expect(result.success).toBe(true);
+    expect(result.evidence.some((item) => item.kind === 'history')).toBe(true);
+  });
+
+  it('未知工具返回 ToolNotFound 错误分类且不抛异常', async () => {
+    const registry = createDefaultToolRegistry();
+    const result = await registry.invoke('time_travel_tool', {}, makeToolContext());
+    expect(result.success).toBe(false);
+    expect(result.errorClass).toBe('ToolNotFound');
+    expect(result.evidence).toEqual([]);
+  });
+
+  it('list 返回五个内置工具清单', () => {
+    const registry = createDefaultToolRegistry();
+    const list = registry.list();
+    expect(list.length).toBe(5);
+    expect(list.map((item) => item.name)).toEqual([
+      'searchKnowledgeBase',
+      'lookupDrug',
+      'checkAllergy',
+      'checkInteraction',
+      'retrievePatientHistory',
+    ]);
+  });
+});
diff --git a/tests/unit/consult-agent/typesSchema.test.ts b/tests/unit/consult-agent/typesSchema.test.ts
new file mode 100644
index 00000000..05f8edfb
--- /dev/null
+++ b/tests/unit/consult-agent/typesSchema.test.ts
@@ -0,0 +1,119 @@
+/**
+ * 单元测试 - types zod schema 红线字面量校验（契约 §1.3 / §15-3）
+ *
+ * Copyright (c) 2026 杭州健澜科技有限公司
+ */
+
+import { describe, expect, it } from 'bun:test';
+
+import { nowIso } from '../../../src/core/agent/consult/roleSupport';
+import type { ConsultDraft } from '../../../src/core/agent/consult/types';
+import {
+  draftSchema,
+  messageSendSchema,
+  threadCreateSchema,
+  transcribeSchema,
+} from '../../../src/core/agent/consult/types';
+
+/** 构造合法草稿用于 schema 基线校验 */
+function validDraft(): ConsultDraft {
+  return {
+    id: 'draft-001',
+    threadId: 'thread-001',
+    kind: 'diagnosis',
+    title: '诊断建议草稿（待执业医师复核）',
+    summary: '头痛伴咳嗽待排查',
+    content: '建议排查常见病因，待医师复核。',
+    evidence: [
+      { kind: 'knowledge', label: '科普条目', source: '知识库 DEMO 条目', snippet: '演示证据内容' },
+    ],
+    needsPhysicianReview: true,
+    isOutOfHospitalPrescription: false,
+    status: 'pending_review',
+    draftHash: 'a'.repeat(64),
+    reviewerId: null,
+    reviewedAt: null,
+    reviewNote: null,
+    createdAt: nowIso(),
+    updatedAt: nowIso(),
+  };
+}
+
+describe('draftSchema 草稿红线字面量', () => {
+  it('合法草稿通过校验', () => {
+    expect(draftSchema.safeParse(validDraft()).success).toBe(true);
+  });
+
+  it('needsPhysicianReview=false 被拒绝（红线反例）', () => {
+    const invalid = { ...validDraft(), needsPhysicianReview: false };
+    expect(draftSchema.safeParse(invalid).success).toBe(false);
+  });
+
+  it('isOutOfHospitalPrescription=true 被拒绝（红线反例）', () => {
+    const invalid = { ...validDraft(), isOutOfHospitalPrescription: true };
+    expect(draftSchema.safeParse(invalid).success).toBe(false);
+  });
+
+  it('status=approved 被拒绝（AI 草稿恒为待复核）', () => {
+    const invalid = { ...validDraft(), status: 'approved' };
+    expect(draftSchema.safeParse(invalid).success).toBe(false);
+  });
+
+  it('status=rejected 被拒绝', () => {
+    const invalid = { ...validDraft(), status: 'rejected' };
+    expect(draftSchema.safeParse(invalid).success).toBe(false);
+  });
+
+  it('evidence 为空数组属于业务可通过 schema、哨兵阶段驳回（schema 层不阻断）', () => {
+    const draft = { ...validDraft(), evidence: [] };
+    expect(draftSchema.safeParse(draft).success).toBe(true);
+  });
+});
+
+describe('threadCreateSchema 创建会话入参', () => {
+  it('合法入参通过：标题可选、patientId 可空', () => {
+    expect(threadCreateSchema.safeParse({}).success).toBe(true);
+    expect(
+      threadCreateSchema.safeParse({ title: '我的咨询', patientId: null, initialMessage: '你好' })
+        .success,
+    ).toBe(true);
+  });
+
+  it('标题超过 120 字符被拒绝', () => {
+    expect(threadCreateSchema.safeParse({ title: '长'.repeat(121) }).success).toBe(false);
+  });
+
+  it('patientId 非 UUID 被拒绝', () => {
+    expect(threadCreateSchema.safeParse({ patientId: 'not-a-uuid' }).success).toBe(false);
+  });
+});
+
+describe('messageSendSchema 发送消息入参', () => {
+  it('非空去空格文本通过', () => {
+    expect(messageSendSchema.safeParse({ content: '  我头痛三天了  ' }).success).toBe(true);
+  });
+
+  it('空串 / 纯空格被拒绝', () => {
+    expect(messageSendSchema.safeParse({ content: '' }).success).toBe(false);
+    expect(messageSendSchema.safeParse({ content: '   ' }).success).toBe(false);
+  });
+
+  it('超过 4000 字符被拒绝', () => {
+    expect(messageSendSchema.safeParse({ content: 'a'.repeat(4001) }).success).toBe(false);
+  });
+});
+
+describe('transcribeSchema 语音转写入参', () => {
+  it('transcript 非空通过', () => {
+    expect(transcribeSchema.safeParse({ transcript: '我头晕' }).success).toBe(true);
+  });
+
+  it('audioText 非空通过', () => {
+    expect(transcribeSchema.safeParse({ audioText: '我头晕' }).success).toBe(true);
+  });
+
+  it('两者皆空被拒绝', () => {
+    expect(transcribeSchema.safeParse({ transcript: '', audioText: '  ' }).success).toBe(false);
+    expect(transcribeSchema.safeParse({}).success).toBe(false);
+  });
+});
