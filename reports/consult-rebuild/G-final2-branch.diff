diff --git a/deploy/postgres/init/384-consult-audit-trail.sql b/deploy/postgres/init/384-consult-audit-trail.sql
new file mode 100644
index 00000000..f0585140
--- /dev/null
+++ b/deploy/postgres/init/384-consult-audit-trail.sql
@@ -0,0 +1,45 @@
+-- ============================================================================
+-- 健澜AI原生医院操作系统OS · M86 consult-agent 智能咨询助手迁移（380–385）
+--
+-- 本文件（384）：咨询助手审计轨迹 consult.audit_trail；父表 consult.threads（见 380）。
+--
+-- 医疗安全红线：
+--  - 四角色（supervisor/examiner/doctor/pharmacist）、system、user 全程留痕，
+--    每条审计透传 trace_id，跨消息/工具/草稿可串联回放；
+--  - 急症旁路（acute_bypass）独立审计：会话转 escalated、不进角色编排、不产草稿；
+--  - 工具审计只留 tool_name/tool_status/duration_ms/evidence_count/error_class/摘要，
+--    detail 为脱敏后结构化摘要，禁止记录原始入参明文；
+--  - 审计记录一经落库不可变更（无 updated_at、无更新触发器），随线程级联删除仅用于
+--    线程回收，正常业务审计不允许改写历史条目。
+--
+-- 权限码（登记与角色授权见 380-consult-threads.sql 末段）：
+--   consult-agent:audit 查看审计轨迹（仅 admin）；read/write 角色不授予审计码。
+--
+-- 幂等：CREATE TABLE IF NOT EXISTS / CREATE INDEX IF NOT EXISTS，可重入。
+-- Copyright (c) 2026 杭州健澜科技有限公司
+-- ============================================================================
+
+CREATE SCHEMA IF NOT EXISTS consult;
+
+-- ---------------------------------------------------------------------------
+-- 角色/工具/急症旁路审计轨迹（trace_id 透传；detail 脱敏后结构化摘要）
+-- ---------------------------------------------------------------------------
+CREATE TABLE IF NOT EXISTS consult.audit_trail (
+  id             uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  thread_id      uuid NOT NULL REFERENCES consult.threads(id) ON DELETE CASCADE,
+  actor_role     text NOT NULL CHECK (actor_role IN ('supervisor','examiner','doctor',
+                                     'pharmacist','system','user')),
+  action         text NOT NULL,
+  tool_name      text,
+  tool_status    text CHECK (tool_status IS NULL OR tool_status IN ('success','error','skipped')),
+  duration_ms    int,
+  evidence_count int,
+  error_class    text,
+  trace_id       text NOT NULL,
+  detail         jsonb NOT NULL DEFAULT '{}'::jsonb,
+  created_at     timestamptz NOT NULL DEFAULT now()
+);
+CREATE INDEX IF NOT EXISTS idx_consult_audit_thread_created
+  ON consult.audit_trail(thread_id, created_at ASC);
+CREATE INDEX IF NOT EXISTS idx_consult_audit_trace
+  ON consult.audit_trail(trace_id);
diff --git a/deploy/postgres/init/385-consult-profile-memory.sql b/deploy/postgres/init/385-consult-profile-memory.sql
new file mode 100644
index 00000000..63f8e4f3
--- /dev/null
+++ b/deploy/postgres/init/385-consult-profile-memory.sql
@@ -0,0 +1,34 @@
+-- ============================================================================
+-- 健澜AI原生医院操作系统OS · M86 consult-agent 智能咨询助手迁移（380–385）
+--
+-- 本文件（385）：用户长期画像记忆 consult.profile_memory；父线程 consult.threads（见 380）。
+--
+-- 医疗安全红线：
+--  - 画像仅沉淀既往过敏史、慢性病、药物不耐受、偏好语言等脱敏事实，供角色工具读取参考，
+--    不替代病历，不据此出具确诊结论；
+--  - facts 条目结构为 { key, value, source, updated_at }，source 标注事实来源会话；
+--  - 画像跨会话复用：线程关闭/删除不清除长期画像，thread_id 仅记录最近来源线程；
+--  - user_id 为跨端用户标识（text），不做强外键约束；事实合并由应用层去重与覆盖。
+--
+-- 权限码（登记与角色授权见 380-consult-threads.sql 末段）：
+--   consult-agent:read 读取画像；consult-agent:write 合并写入画像事实。
+--
+-- 幂等：CREATE TABLE IF NOT EXISTS / DROP TRIGGER IF EXISTS，可重入。
+-- Copyright (c) 2026 杭州健澜科技有限公司
+-- ============================================================================
+
+CREATE SCHEMA IF NOT EXISTS consult;
+
+-- ---------------------------------------------------------------------------
+-- 用户长期画像事实（每用户一行，facts 为 ProfileFact 数组；UNIQUE(user_id)）
+-- ---------------------------------------------------------------------------
+CREATE TABLE IF NOT EXISTS consult.profile_memory (
+  id          uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  user_id     text NOT NULL UNIQUE,
+  thread_id   uuid REFERENCES consult.threads(id) ON DELETE SET NULL,
+  facts       jsonb NOT NULL DEFAULT '[]'::jsonb,
+  updated_at  timestamptz NOT NULL DEFAULT now()
+);
+DROP TRIGGER IF EXISTS trg_consult_profile_updated ON consult.profile_memory;
+CREATE TRIGGER trg_consult_profile_updated BEFORE UPDATE ON consult.profile_memory
+  FOR EACH ROW EXECUTE FUNCTION public.set_updated_at();
