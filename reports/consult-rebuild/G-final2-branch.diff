+
+/** 工具调用折叠卡片：标题仅展示工具名 / 状态；展开后显示脱敏结果摘要，禁止回显原始入参 */
+function ConsultToolCard({ message }: { message: ConsultMessage }) {
+  const record = message.toolCalls?.[0] ?? null;
