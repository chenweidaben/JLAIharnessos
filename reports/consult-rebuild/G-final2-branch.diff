+              }
+              value={input}
+              onChange={(e) => setInput(e.target.value)}
+              onPressEnter={() => handleSend()}
+              disabled={sending || isTerminal}
+            />
+            <Button
+              type="primary"
+              icon={<SendOutlined />}
+              style={{ background: PRIMARY, borderColor: PRIMARY }}
+              loading={sending}
+              disabled={isTerminal}
+              onClick={() => handleSend()}
+            >
+              发送
+            </Button>
+          </div>
+
+          {/* 免责声明常驻页面底部 */}
+          <div
+            style={{
+              padding: '8px 12px',
+              background: BG_SOFT,
+              borderTop: '1px solid #d9e3ef',
+              fontSize: 11,
+              color: '#5a6b82',
+              lineHeight: 1.6,
+            }}
+          >
+            {DISCLAIMER}
+          </div>
+        </div>
+
+        {/* 草稿面板 */}
+        <div
+          style={{
+            width: 300,
+            flexShrink: 0,
+            background: '#fff',
+            border: '1px solid #d9e3ef',
+            borderRadius: 8,
+            display: 'flex',
+            flexDirection: 'column',
+            overflow: 'hidden',
+          }}
+        >
+          <div
+            style={{
+              padding: '8px 10px',
+              background: BG_SOFT,
+              color: PRIMARY,
+              fontWeight: 600,
+              borderBottom: '1px solid #d9e3ef',
+            }}
+          >
+            AI 草稿（待执业医师复核）
+          </div>
+          <div style={{ flex: 1, overflowY: 'auto', padding: 10 }}>
+            {drafts.length === 0 ? (
+              <Empty description="暂无诊断 / 处方草稿" style={{ padding: 24 }} />
+            ) : (
+              drafts.map((draft) => <ConsultDraftCard key={draft.id} draft={draft} />)
+            )}
+          </div>
+        </div>
+      </div>
+
+      <style>{`@keyframes consult-blink { 50% { opacity: 0; } }`}</style>
+    </PageContainer>
+  );
+}
