+/**
+ * 单元测试 - 免责声明常驻校验（契约 §15-2）
+ *
+ * Copyright (c) 2026 杭州健澜科技有限公司
+ */
+
+import { describe, expect, it } from 'bun:test';
+
+import { createSafeLlm } from '../../../src/core/agent/consult/llm/safeLlm';
+import {
+  DoctorRole,
+  ExaminerRole,
+  PharmacistRole,
