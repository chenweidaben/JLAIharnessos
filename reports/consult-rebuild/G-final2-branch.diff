new file mode 100644
index 00000000..bdfc34a8
--- /dev/null
+++ b/deploy/postgres/init/381-consult-messages.sql
@@ -0,0 +1,44 @@
+-- ============================================================================
+-- 健澜AI原生医院操作系统OS · M86 consult-agent 智能咨询助手迁移（380–385）
+--
+-- 本文件（381）：会话消息 consult.messages；父表 consult.threads（见 380）。
+--
+-- 医疗安全红线：
+--  - AI 回复仅为辅助科普与就诊参考，每条 assistant 消息携带免责声明，不构成诊断；
+--  - 急症旁路消息为 system/assistant 引导，不含诊疗结论；
+--  - tool_calls 仅保留工具调用记录（callId/name/status/耗时/证据数/错误分类/摘要），
+--    禁止保存与回显原始入参明文；
+--  - 消息一经落库不可变更（无 updated_at、无更新触发器），审计由 consult.audit_trail 承担。
+--
+-- 权限码（登记与角色授权见 380-consult-threads.sql 末段）：
+--   consult-agent:read   读取历史消息；consult-agent:write 发送消息/转写/流式会话。
+--
+-- 幂等：CREATE TABLE IF NOT EXISTS / CREATE INDEX IF NOT EXISTS，可重入。
+-- Copyright (c) 2026 杭州健澜科技有限公司
+-- ============================================================================
+
+CREATE SCHEMA IF NOT EXISTS consult;
+
+-- ---------------------------------------------------------------------------
+-- 会话消息（role: user/assistant/tool/system；消息随线程级联删除）
+-- ---------------------------------------------------------------------------
+CREATE TABLE IF NOT EXISTS consult.messages (
+  id            uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  thread_id     uuid NOT NULL REFERENCES consult.threads(id) ON DELETE CASCADE,
+  role          text NOT NULL CHECK (role IN ('user','assistant','tool','system')),
+  content       text NOT NULL DEFAULT '',
+  intent        text CHECK (intent IS NULL OR intent IN ('greeting','symptom_report',
+                                'clarification_answer','medication_question','chronic_management',
+                                'acute_emergency','document_upload','exit','unknown')),
+  role_kind    text CHECK (role_kind IS NULL OR role_kind IN
+                                ('supervisor','examiner','doctor','pharmacist')),
+  tool_calls    jsonb NOT NULL DEFAULT '[]'::jsonb,
+  tool_name     text,
+  safety_level  text NOT NULL DEFAULT 'normal'
+                CHECK (safety_level IN ('normal','caution','acute')),
+  disclaimer    text NOT NULL DEFAULT '',
+  trace_id      text NOT NULL,
+  created_at    timestamptz NOT NULL DEFAULT now()
+);
+CREATE INDEX IF NOT EXISTS idx_consult_messages_thread_created
+  ON consult.messages(thread_id, created_at ASC);
diff --git a/deploy/postgres/init/382-consult-documents.sql b/deploy/postgres/init/382-consult-documents.sql
new file mode 100644
index 00000000..132cbed4
--- /dev/null
+++ b/deploy/postgres/init/382-consult-documents.sql
@@ -0,0 +1,37 @@
+-- ============================================================================
+-- 健澜AI原生医院操作系统OS · M86 consult-agent 智能咨询助手迁移（380–385）
+--
+-- 本文件（382）：会话附件 consult.documents；父表 consult.threads（见 380），
+--   可选归属消息 consult.messages（见 381）。
+--
+-- 医疗安全红线：
+--  - 上传报告/化验单/影像/病历等仅作为证据材料抽取与辅助参考，AI 不据此出具确诊结论；
+--  - extracted_evidence 只存脱敏后结构化证据条目（kind/label/source/snippet），
+--    原始入参与未脱敏正文不回显、不扩散；
+--  - 附件随线程级联删除；message_id 可空，消息先删时记录保留为线程级附件。
+--
+-- 权限码（登记与角色授权见 380-consult-threads.sql 末段）：
+--   consult-agent:read 查看附件与抽取证据；consult-agent:write 上传附件。
+--
+-- 幂等：CREATE TABLE IF NOT EXISTS / CREATE INDEX IF NOT EXISTS，可重入。
+-- Copyright (c) 2026 杭州健澜科技有限公司
+-- ============================================================================
+
+CREATE SCHEMA IF NOT EXISTS consult;
+
+-- ---------------------------------------------------------------------------
+-- 会话上传附件（病历/化验单/影像报告等；证据抽取结果结构化落 jsonb）
+-- ---------------------------------------------------------------------------
+CREATE TABLE IF NOT EXISTS consult.documents (
+  id                uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  thread_id         uuid NOT NULL REFERENCES consult.threads(id) ON DELETE CASCADE,
+  message_id        uuid REFERENCES consult.messages(id),
+  file_name         text NOT NULL,
+  mime_type         text NOT NULL DEFAULT 'application/octet-stream',
+  size_bytes        bigint,
+  evidence_summary  text,
+  extracted_evidence jsonb NOT NULL DEFAULT '[]'::jsonb,
+  created_at        timestamptz NOT NULL DEFAULT now()
+);
+CREATE INDEX IF NOT EXISTS idx_consult_documents_thread_created
+  ON consult.documents(thread_id, created_at ASC);
diff --git a/deploy/postgres/init/383-consult-drafts.sql b/deploy/postgres/init/383-consult-drafts.sql
new file mode 100644
index 00000000..ceac7dd5
--- /dev/null
+++ b/deploy/postgres/init/383-consult-drafts.sql
@@ -0,0 +1,56 @@
+-- ============================================================================
+-- 健澜AI原生医院操作系统OS · M86 consult-agent 智能咨询助手迁移（380–385）
+--
+-- 本文件（383）：诊断建议/用药处方 AI 草稿 consult.diagnosis_prescription_drafts；
+--   父表 consult.threads（见 380）。
+--
+-- 医疗安全红线（数据库层强制兜底，应用层 zod 字面量双保险）：
+--  - AI 草稿恒需执业医师复核：needs_physician_review = true（CHECK 锁定，禁止写 false）；
+--  - 处方草稿恒为非院外处方：is_out_of_hospital_prescription = false（CHECK 锁定，
+--    AI 不开具院外处方、不直接生成在院医嘱，须经医师线下/院内系统确认）；
+--  - 草稿状态恒为待复核：status = 'pending_review'（CHECK 锁定，不存在 AI 自主 approved 态）；
+--  - kind 仅限 diagnosis（诊断建议）/ prescription（用药审方建议）；
+--  - 同线程同类型同 draft_hash 唯一，Sentinel 审批网关据此去重，不重复落库；
+--  - evidence 为脱敏后证据条目（kind/label/source/snippet），禁止原始入参明文入库。
+--
+-- 权限码（登记与角色授权见 380-consult-threads.sql 末段）：
+--   consult-agent:read 查询草稿；consult-agent:write 生成草稿；复核动作不开放给 AI 写码。
+--
+-- 幂等：CREATE TABLE IF NOT EXISTS / CREATE UNIQUE INDEX IF NOT EXISTS /
+--       CREATE INDEX IF NOT EXISTS / DROP TRIGGER IF EXISTS，可重入。
+-- Copyright (c) 2026 杭州健澜科技有限公司
+-- ============================================================================
+
+CREATE SCHEMA IF NOT EXISTS consult;
+
+-- ---------------------------------------------------------------------------
+-- 诊断建议 / 用药处方 AI 草稿（待医师复核；红线布尔与状态由 CHECK 锁定）
+-- ---------------------------------------------------------------------------
+CREATE TABLE IF NOT EXISTS consult.diagnosis_prescription_drafts (
+  id                              uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  thread_id                       uuid NOT NULL REFERENCES consult.threads(id) ON DELETE CASCADE,
+  kind                            text NOT NULL CHECK (kind IN ('diagnosis','prescription')),
+  title                           text NOT NULL DEFAULT '',
+  summary                         text NOT NULL DEFAULT '',
+  content                         text NOT NULL DEFAULT '',
+  evidence                        jsonb NOT NULL DEFAULT '[]'::jsonb,
+  needs_physician_review          boolean NOT NULL DEFAULT true
+                                  CHECK (needs_physician_review = true),
