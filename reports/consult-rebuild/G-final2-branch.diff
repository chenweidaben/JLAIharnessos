+                style={{ padding: 40 }}
+              />
+            )}
+
+            {messages.map((message) =>
+              message.role === 'tool' ? (
+                <div
+                  key={message.id}
+                  style={{ display: 'flex', justifyContent: 'flex-start', marginBottom: 12 }}
+                >
+                  <ConsultToolCard message={message} />
+                </div>
+              ) : message.role === 'system' ? (
+                <div
+                  key={message.id}
+                  style={{
+                    textAlign: 'center',
+                    color: '#888',
+                    fontSize: 12,
+                    marginBottom: 12,
+                  }}
+                >
+                  {message.content}
+                </div>
+              ) : (
+                <div
+                  key={message.id}
+                  style={{
+                    display: 'flex',
+                    justifyContent: message.role === 'user' ? 'flex-end' : 'flex-start',
+                    marginBottom: 12,
+                  }}
+                >
+                  <div
+                    style={{
+                      maxWidth: '72%',
+                      background: message.role === 'user' ? PRIMARY : '#fff',
+                      color: message.role === 'user' ? '#fff' : '#1f1f1f',
+                      border: message.role === 'user' ? 'none' : '1px solid #e5e9f0',
+                      borderRadius: 10,
+                      padding: '10px 14px',
+                    }}
+                  >
+                    <div
+                      style={{
+                        display: 'flex',
+                        alignItems: 'center',
+                        gap: 6,
+                        marginBottom: 4,
+                      }}
