# 依赖
node_modules/
.pnp/
.pnp.js

# 构建产物
dist/
build/
out/
*.tsbuildinfo
tsconfig.tsbuildinfo

# 环境变量与密钥（严禁提交真实密钥）
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production

# MFA 主密钥库（运行时生成，AES-256-GCM 加密 TOTP 因子用，严禁入库）
.keys/

# 测试与覆盖率
coverage/
*.lcov
.nyc_output/

# 日志
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun-debug.log*

# 运行时数据
data/
!src/data/
runtime/
!src/bff/runtime/
tmp/
*.pid
*.seed

# 编辑器
.vscode/
.idea/
*.swp
*.swo
*~

# 操作系统
.DS_Store
Thumbs.db
Desktop.ini

# 包管理器 lock 策略：
#   后端用 bun，提交根 bun.lock；web 用 npm，提交 web/package-lock.json。
#   忽略其余位置误生成的 npm lock 与 web 下的 bun lock，避免双包管理器混乱。
package-lock.json
!web/package-lock.json
web/bun.lock
bun.lockb
pnpm-lock.yaml

# 原始/大体积知识数据与压缩包（开放数据由下载器按需获取，见 DATA_LICENSES.md）
*.tar.gz
*.tgz
*.zip
data/knowledge/raw/

# Python 临时产物（scripts/ 下的解析脚本）
__pycache__/
*.pyc
.venv/

# ---------- DAMO-RADAR 推理服务（运行时产物 / 权重，严禁入库） ----------
# 约 5GB 模型权重（CC BY-NC-SA 4.0 非商业），由部署方自行下载，见 DATA_LICENSES.md
services/radar-inference/models/
services/radar-inference/.venv/
services/radar-inference/__pycache__/
services/radar-inference/data/
**/__pycache__/
.pytest_cache/
# 根级权重卷与 BFF 运行时 AI 作业持久化（运行时产物，勿入库）
models/
data/imaging-ai-jobs.json

# CI / 本地报告
test-results/
playwright-report/

# 第三方产品资料（外部产品截图/文档，版权原因不随开源发布，本地保留）
docs/requirements/images/

# 调试 / 导出用临时截图
*_debug.png
web/outpatient_debug.png

# 运行日志与E2E产物（不入库）
artifacts/*.log
*.log

# 临时提交信息文件（git commit -F 用，禁止入库）
.commitmsg*.txt
.commitmsg*.tmp

# 根目录历史批次取证/探针临时文本（仅锚定根目录散落 *.txt；docs/reports/src 等子目录内文本不受影响；已跟踪文件由收口环节 git rm --cached 取消跟踪）
/*.txt
# web 根目录历史探针/构建/覆盖率/e2e 输出文本（仅 web 根目录，web/src、web/tests 不受影响）
/web/*.txt
/web/build_out.txt
/web/coverage_out.txt
# 根目录历史探针导出 CSV（正式数据报表放 reports/ 子目录，不锚定子目录）
/*.csv

# scripts 历史探针产物（本地保留，不入库；源码 .ts 不受影响）
/scripts/demo-token.txt
/scripts/probe-results*.csv
/scripts/probe-v2-output.txt

# reports 根目录本地取证文本/表格（正式报告放 reports/ 子目录 .md；已跟踪历史文件不受本规则影响）
reports/*.txt
reports/*.csv

# 源码内业务目录与运行时目录同名误伤豁免（仅放行下列具体源码路径，不放宽日志/覆盖率/运行时规则本身；
# 规则写在对应忽略规则之后以保证优先级）
!web/src/pages/fhir/coverage/
!web/src/pages/fhir/coverage/**
!src/core/agent/consult/runtime/
!src/core/agent/consult/runtime/**
# radar 服务随源码打包的内嵌契约兜底数据（根契约缺失时的回退；Dockerfile COPY app/data 依赖本目录）
!services/radar-inference/app/data/
!services/radar-inference/app/data/**
